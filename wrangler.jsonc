{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "muster",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-20",
  "observability": { "enabled": true },

  // The UI is a static build (vite build → dist). The Worker runs first only for the API and for
  // poll pages, whose HTML it fills with the poll's title so links unfurl in Discord.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/e/*", "/auth/*", "/discord/*"]
  },

  // One Durable Object per poll, holding the poll and everyone's answers in its own SQLite storage.
  // SQLite-backed objects are on the Workers Free plan, and need nothing created beforehand.
  "durable_objects": {
    "bindings": [{ "name": "POLLS", "class_name": "PollObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PollObject"] }],

  // Sign in with Discord, and the bot. The client secret, the bot's token and the app's public key are Worker
  // secrets (wrangler secret put DISCORD_CLIENT_SECRET, DISCORD_BOT_TOKEN, DISCORD_PUBLIC_KEY);
  // DISCORD_ORIGIN is only changed by the end-to-end run, which stands in for Discord.
  "vars": { "DISCORD_CLIENT_ID": "1575719104306880626", "DISCORD_ORIGIN": "https://discord.com" },

  // wrangler deploy attaches the subdomain and creates its DNS record, since fayelore.com is on Cloudflare.
  "routes": [{ "pattern": "muster.fayelore.com", "custom_domain": true }],

  // A preview to try changes on before they go live: `npm run deploy:preview` puts this branch at
  // https://muster-preview.fayelore.workers.dev, a separate Worker with its own polls, so nothing there
  // touches the live ones.
  "env": {
    "preview": {
      "name": "muster-preview",
      "workers_dev": true,
      "routes": [],
      "vars": { "DISCORD_CLIENT_ID": "1575719104306880626", "DISCORD_ORIGIN": "https://discord.com" },
      "durable_objects": {
        "bindings": [{ "name": "POLLS", "class_name": "PollObject" }]
      }
    }
  }
}
